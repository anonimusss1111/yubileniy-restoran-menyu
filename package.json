{
  "name": "yubileniy-restoran-menyu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "dev:lan": "next dev -H 0.0.0.0",
    "images:optimize": "tsx scripts/optimize-image.ts",
    "brand:assets": "tsx scripts/make-brand-assets.ts",
    "db:seed:prod": "tsx prisma/seed-prod.ts",
    "preflight": "tsx scripts/preflight.ts",
    "render:env": "tsx scripts/render-env.ts",
    "render:env:clean": "rm -f render.env"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@prisma/client": "^5.22.0",
    "zod": "^3.23.8",
    "react-hook-form": "^7.53.2",
    "@hookform/resolvers": "^3.9.1",
    "sonner": "^1.7.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "embla-carousel-react": "^8.3.0",
    "embla-carousel-autoplay": "^8.3.0",
    "swr": "^2.2.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "jose": "^5.9.6",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^0.460.0",
    "framer-motion": "^11.11.17",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "vaul": "^1.1.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  }
}
